# Ignore common file types
*.pdf
*.json
*.jsonl
*.html
*.txt
*.jpg
*.png

# Ignore system files
.DS_Store

# Ignore output directories
/debug_output
/rendered_images
/dolma_previews
/results

# Ignore files generated by IDEs or editors
/.idea/
.vscode/

# Ignore compiled binary files and object files
/build/
.obj/
*.o
*.so

# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo

# Ignore package manager-related files and directories
/pip-cache/
/node_modules/
/yarn.lock

# Ignore virtual environments
/env/
.venv/
venv/

# Ignore environment-specific files and directories
.env
.env.*

# Ignore log files
*.log

# Ignore temporary and backup files
*.swp
*.bak
*.tmp

#Ignore audio files
*.mp3
*.wav
*.ogg
*.m4a
*.flac
*.aac
*.wma
*.mp4

# Ignore sensitive data (adjust according to your project's needs)
config.yml
credentials.json
transcribed/
transcribed.txt
error.txt

# Ignore MacOS-specific property list files
*.plist

# Ignore Windows-specific files and directories (optional)
Thumbs.db
ehthumbs.db
